# Copy to .env and fill in. See README.md for how to get the Firebase values.

PORT=4000

# Origin the dashboard is served from, for CORS. Vite's default dev port.
FRONTEND_ORIGIN=http://localhost:5173

# Firebase project → Project settings → Service accounts → Generate new private key.
# Paste the three fields from that downloaded JSON file here.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes in the private key literal (don't turn them into real newlines).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Where uploaded disease/pest photos are saved (relative to server/, or an absolute path).
UPLOADS_DIR=./uploads
